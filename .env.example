# =====================================================================
# Configuración de conexión a PostgreSQL (administrado o local)
# Copie este archivo a .env y complete los valores reales.
# NUNCA suba este archivo con valores reales a git. Los secretos viajan
# por variables de entorno / secretos de la plataforma de despliegue.
# =====================================================================

# --- Persistencia ---
# URL de conexión SQLAlchemy/psycopg2 a PostgreSQL.
# Ejemplo local:  postgresql+psycopg2://viajes_zonas:viajes_zonas_dev@localhost:5433/viajes_zonas
# Ejemplo Azure:  postgresql+psycopg2://usuario@servidor.postgres.database.azure.com:5432/bd?sslmode=require
DATABASE_URL=

# Modo SSL para bases administradas (prefer | require | disable). Local: prefer.
DATABASE_SSL_MODE=prefer

# Entorno de ejecución: local | managed | production
APP_ENV=local

# Puerto de la API CRUD
API_CRUD_PORT=8100

# Puerto de la API MID
API_MID_PORT=8101

# --- Reglas de negocio (viajes y zonas) ---
# Saldo mínimo necesario para iniciar un viaje (COP)
SALDO_MINIMO=5000
# Batería mínima del vehículo para iniciar un viaje (%)
BATERIA_MINIMA=15
# Tarifa de desbloqueo (COP)
TARIFA_DESBLOQUEO=1000
# Tarifa por minuto de viaje (COP)
TARIFA_POR_MINUTO=350
# Recargo por zona de tipo "recargo" (%)
RECARGO_ZONA_PCT=20
# Descuento primer viaje del usuario (%)
DESCUENTO_PRIMER_VIAJE_PCT=50

# --- API Gateway (para consumo de APIs de terceros servicios) ---
GATEWAY_URL=https://gateway.example.test
GATEWAY_CLIENT_ID=viajes-mid-client
GATEWAY_CLIENT_SECRET=replace-me
GATEWAY_SECRET=replace-me
GATEWAY_TOKEN_URL=${GATEWAY_URL}/token
TOKEN_SCOPE=zonas:leer,vehiculos:leer,vehiculos:escribir,usuarios:leer,billetera:escribir

# --- APIs integradas (a través del gateway) ---
CUENTAS_URL=https://gateway.example.test/cuentas
FLOTA_URL=https://gateway.example.test/flota
